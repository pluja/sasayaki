    <string name="onboarding_welcome_title">Speak, and it\'s typed.</string>
    <string name="onboarding_welcome_body">Sasayaki turns your voice into text in any app, using speech models on servers you choose.</string>
    <string name="onboarding_point_apps_title">Works in every app</string>
    <string name="onboarding_point_apps_body">Dictate from a floating bubble or your keyboard\'s mic key.</string>
    <string name="onboarding_point_servers_title">Your servers, your words</string>
    <string name="onboarding_point_servers_body">Recordings go only to the servers you add.</string>
    <string name="onboarding_point_cleanup_title">Optional cleanup</string>
    <string name="onboarding_point_cleanup_body">Add a chat model and Sasayaki drops filler words and applies your self-corrections.</string>

    <string name="onboarding_provider_title">Connect speech to text</string>
    <string name="onboarding_provider_body">Add the server that turns your voice into text. Any OpenAI-compatible API works: your own or a hosted one.</string>
    <string name="onboarding_test_connection">Test connection</string>
    <string name="onboarding_provider_needs_url">Enter your server address to continue.</string>
    <string name="onboarding_provider_needs_model">Test the connection or pick a speech to text model to continue.</string>
    <string name="onboarding_cleanup_on">Cleanup is on: a chat model will tidy each dictation before it is typed.</string>
    <string name="onboarding_cleanup_optional">Cleanup is optional. It needs a chat model (an LLM) to remove filler words and fix self-corrections. Pick one under Cleanup above, or add it later in Settings.</string>

    <string name="onboarding_method_title">How do you want to dictate?</string>
    <string name="onboarding_method_body">Pick one to start with. You can turn on the other later in Settings.</string>
    <string name="onboarding_method_bubble_title">Floating bubble</string>
    <string name="onboarding_method_bubble_body">Appears whenever a keyboard opens, in any app. Tap it to dictate into the field you are in.</string>
    <string name="onboarding_method_bubble_needs">Needs: display over other apps, and accessibility access to type the text.</string>
    <string name="onboarding_method_keyboard_title">Keyboard mic key</string>
    <string name="onboarding_method_keyboard_body">Keyboards like HeliBoard and FlorisBoard open Sasayaki from their mic key, right in the keyboard area.</string>
    <string name="onboarding_method_keyboard_needs">Needs: only the microphone.</string>

    <string name="onboarding_permissions_bubble_title">Let Sasayaki listen and type</string>
    <string name="onboarding_permissions_bubble_body">These let the bubble record when you tap it and type the result where you are.</string>
    <string name="onboarding_permissions_keyboard_title">Connect your keyboard</string>
    <string name="onboarding_permissions_keyboard_body">Allow the microphone, then turn on Sasayaki voice input so your keyboard\'s mic key can open it.</string>

    <string name="onboarding_try_title">Try it</string>
    <string name="onboarding_try_not_ready">Finish the previous step to start dictating. You can also do it later from Home.</string>
    <string name="onboarding_try_keyboard">Tap the field below, then the mic key on your keyboard and say something.</string>
    <string name="onboarding_try_bubble">Tap the field below, then tap the bubble that appears and say something.</string>
    <string name="onboarding_try_placeholder">Your words appear here</string>
    <string name="onboarding_starting_bubble">Starting the bubble…</string>

